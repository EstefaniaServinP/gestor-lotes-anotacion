# =============================================================================
# Configuración del Gestor de Lotes de Anotación
# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# =============================================================================

# Nombre que aparece en los reportes
PROJECT_NAME=Gestor de Lotes

# Servidor de desarrollo (python app.py)
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=1

# MongoDB principal (batches, segmentadores, máscaras, reportes)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=planta_a
# Con autenticación:
# MONGO_URI=mongodb://usuario:contraseña@localhost:27017/?authSource=admin

# MongoDB externo del segmentador (sincronización de máscaras)
MASKS_URI=mongodb://localhost:27017
MASKS_DB=training_db
MASKS_COLLECTION=masks.files

# Administrador inicial: si el equipo no tiene ningún admin, se crea al arrancar
ADMIN_NAME=Administrador
# Contraseña para crear/editar administradores (obligatoria para esas acciones)
ADMIN_PASSWORD=cambia-esta-contraseña

# Carpeta base de las imágenes de cada lote y catálogo JSON de lotes
DATA_DIRECTORY=./data/imagenes
BATCHES_FILE=data/batches_ejemplo.json

# Gunicorn (producción)
GUNICORN_WORKERS=4
BIND_ADDRESS=0.0.0.0:5000
